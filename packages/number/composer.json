{
    "name": "bladewindui/number",
    "description": "BladewindUI — Numeric stepper component",
    "keywords": [
        "laravel",
        "blade",
        "tailwindcss",
        "bladewindui",
        "number"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Michael K. Ocansey",
            "email": "mike@bladewindui.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "bladewindui/core": "^5.0",
        "bladewindui/script": "^5.0",
        "bladewindui/input": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Mkocansey\\Bladewind\\Number\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mkocansey\\Bladewind\\Number\\BladewindNumberServiceProvider"
            ]
        }
    }
}
