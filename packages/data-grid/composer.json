{
    "name": "bladewindui/data-grid",
    "description": "BladewindUI accessible data grid — a higher-level companion to Table with column sorting, filtering, selection, sticky headers, and server-driven state",
    "keywords": [
        "laravel",
        "blade",
        "tailwindcss",
        "bladewindui",
        "data-grid",
        "table",
        "content"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Michael K. Ocansey",
            "email": "mike@bladewindui.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "bladewindui/core": "^5.1",
        "bladewindui/icon": "^5.1",
        "bladewindui/pagination": "^5.1",
        "bladewindui/spinner": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "Mkocansey\\Bladewind\\DataGrid\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mkocansey\\Bladewind\\DataGrid\\BladewindDataGridServiceProvider"
            ]
        }
    }
}
