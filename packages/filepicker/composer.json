{
    "name": "bladewindui/filepicker",
    "description": "BladewindUI — File picker component (powered by FilePond)",
    "keywords": [
        "laravel",
        "blade",
        "tailwindcss",
        "bladewindui",
        "filepicker"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Michael K. Ocansey",
            "email": "mike@bladewindui.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "bladewindui/core": "^4.5",
        "bladewindui/script": "^4.5"
    },
    "autoload": {
        "psr-4": {
            "Mkocansey\\Bladewind\\Filepicker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mkocansey\\Bladewind\\Filepicker\\BladewindFilepickerServiceProvider"
            ]
        }
    }
}
