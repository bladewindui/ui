{
    "name": "bladewindui/timepicker",
    "description": "BladewindUI — Timepicker component",
    "keywords": [
        "laravel",
        "blade",
        "tailwindcss",
        "bladewindui",
        "timepicker"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Michael K. Ocansey",
            "email": "mike@bladewindui.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "bladewindui/core": "^4.4",
        "bladewindui/icon": "^4.4",
        "bladewindui/script": "^4.4",
        "bladewindui/input": "^4.4",
        "bladewindui/modal": "^4.4",
        "bladewindui/select": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "Mkocansey\\Bladewind\\Timepicker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mkocansey\\Bladewind\\Timepicker\\BladewindTimepickerServiceProvider"
            ]
        }
    }
}
