{
    "name": "bladewindui/currency-input",
    "description": "BladewindUI — Currency / money input component",
    "keywords": [
        "laravel",
        "blade",
        "tailwindcss",
        "bladewindui",
        "currency-input",
        "money"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Michael K. Ocansey",
            "email": "mike@bladewindui.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "bladewindui/core": "^5.0",
        "bladewindui/input": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Mkocansey\\Bladewind\\CurrencyInput\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mkocansey\\Bladewind\\CurrencyInput\\BladewindCurrencyInputServiceProvider"
            ]
        }
    }
