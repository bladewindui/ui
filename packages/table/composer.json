{
    "name": "bladewindui/table",
    "description": "BladewindUI Table component — searchable, sortable, paginated data table",
    "keywords": [
        "laravel",
        "blade",
        "tailwindcss",
        "bladewindui",
        "table",
        "datatable"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Michael K. Ocansey",
            "email": "mike@bladewindui.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "bladewindui/core": "^4.4",
        "bladewindui/icon": "^4.4",
        "bladewindui/script": "^4.4",
        "bladewindui/spinner": "^4.4",
        "bladewindui/button": "^4.4",
        "bladewindui/input": "^4.4",
        "bladewindui/checkbox": "^4.4",
        "bladewindui/empty-state": "^4.4",
        "bladewindui/pagination": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "Mkocansey\\Bladewind\\Table\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mkocansey\\Bladewind\\Table\\BladewindTableServiceProvider"
            ]
        }
    }
}
