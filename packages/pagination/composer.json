{
    "name": "bladewindui/pagination",
    "description": "BladewindUI — Pagination component",
    "keywords": [
        "laravel",
        "blade",
        "tailwindcss",
        "bladewindui",
        "pagination"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Michael K. Ocansey",
            "email": "mike@bladewindui.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "bladewindui/core": "^4.4",
        "bladewindui/icon": "^4.4",
        "bladewindui/script": "^4.4",
        "bladewindui/button": "^4.4",
        "bladewindui/select": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "Mkocansey\\Bladewind\\Pagination\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mkocansey\\Bladewind\\Pagination\\BladewindPaginationServiceProvider"
            ]
        }
    }
}
