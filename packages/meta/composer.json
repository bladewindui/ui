{
    "name": "mkocansey/bladewind",
    "description": "BladewindUI — elegant Laravel Blade UI components powered by TailwindCSS",
    "keywords": [
        "laravel",
        "blade",
        "tailwindcss",
        "ui components",
        "bladewindui"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Michael K. Ocansey",
            "email": "mike@bladewindui.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "bladewindui/core": "^4.5",
        "bladewindui/icon": "^4.5",
        "bladewindui/script": "^4.5",
        "bladewindui/spinner": "^4.5",
        "bladewindui/button": "^4.5",
        "bladewindui/alert": "^4.5",
        "bladewindui/bell": "^4.5",
        "bladewindui/notification": "^4.5",
        "bladewindui/modal": "^4.5",
        "bladewindui/drawer": "^4.5",
        "bladewindui/table": "^4.5",
        "bladewindui/forms": "^4.5",
        "bladewindui/content": "^4.5",
        "bladewindui/navigation": "^4.5"
    },
    "autoload": {
        "psr-4": {
            "Mkocansey\\Bladewind\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mkocansey\\Bladewind\\BladewindServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php -r \"if (file_exists('artisan')) passthru('php artisan vendor:publish --tag=bladewind-public --force');\"",
            "@php -r \"if (file_exists('artisan')) passthru('php artisan vendor:publish --tag=bladewind-lang --force');\""
        ]
    }
}
