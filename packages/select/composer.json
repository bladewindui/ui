{
    "name": "mkocansey/bladewind-select",
    "description": "BladewindUI — Select / dropdown component",
    "keywords": [
        "laravel",
        "blade",
        "tailwindcss",
        "bladewindui",
        "select"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Michael K. Ocansey",
            "email": "mike@bladewindui.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "mkocansey/bladewind-core": "^4.3",
        "mkocansey/bladewind-icon": "^4.3",
        "mkocansey/bladewind-script": "^4.3",
        "mkocansey/bladewind-spinner": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "Mkocansey\\Bladewind\\Select\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mkocansey\\Bladewind\\Select\\BladewindSelectServiceProvider"
            ]
        }
    }
}
